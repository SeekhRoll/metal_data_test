[
 {
  "from": 0.9,
  "to": 3.17,
  "lines": [
   "पंचतंत्र की एक कथा…"
  ]
 },
 {
  "from": 5.4,
  "to": 10.13,
  "lines": [
   "कबूतरों का एक झुंड था।",
   "उनका राजा था, चित्रग्रीव।"
  ]
 },
 {
  "from": 13.1,
  "to": 16.8,
  "lines": [
   "एक दिन एक बहेलिए ने",
   "ज़मीन पर दाने बिखेरे,"
  ]
 },
 {
  "from": 16.84,
  "to": 18.71,
  "lines": [
   "और ऊपर जाल बिछा दिया।"
  ]
 },
 {
  "from": 18.75,
  "to": 20.16,
  "lines": [
   "दाने देखकर,",
   "कबूतर नीचे उतर आए…"
  ]
 },
 {
  "from": 20.2,
  "to": 22.19,
  "lines": [
   "…और सब जाल में फँस गए।"
  ]
 },
 {
  "from": 22.23,
  "to": 26.71,
  "lines": [
   "हर कोई अपनी ओर फड़फड़ाया,",
   "पर जाल हिला तक नहीं।"
  ]
 },
 {
  "from": 27.1,
  "to": 31.31,
  "lines": [
   "तब चित्रग्रीव बोला,",
   "\"घबराओ मत। सब एक साथ उड़ो!\""
  ]
 },
 {
  "from": 31.35,
  "to": 35.06,
  "lines": [
   "और पूरा झुंड, जाल समेत,",
   "आसमान में उड़ गया।"
  ]
 },
 {
  "from": 35.1,
  "to": 38.85,
  "lines": [
   "वे पहुँचे अपने मित्र,",
   "चूहे हिरण्यक के पास।"
  ]
 },
 {
  "from": 38.89,
  "to": 43.0,
  "lines": [
   "चित्रग्रीव बोला, \"पहले",
   "मेरे साथियों को छुड़ाओ,"
  ]
 },
 {
  "from": 43.04,
  "to": 41.66,
  "lines": [
   "मुझे सबसे आख़िर में।\""
  ]
 },
 {
  "from": 41.7,
  "to": 44.98,
  "lines": [
   "हिरण्यक ने",
   "एक-एक धागा काट दिया।"
  ]
 },
 {
  "from": 51.3,
  "to": 53.28,
  "lines": [
   "साथ बैठिए, साथ बाँटिए।"
  ]
 },
 {
  "from": 53.32,
  "to": 57.14,
  "lines": [
   "श्री देसी ठेकुआ —",
   "घर का बना, प्रेम से बना।"
  ]
 },
 {
  "from": 57.18,
  "to": 59.17,
  "lines": [
   "अब आपकी द्वारका तक।"
  ]
 }
]