[
 {
  "from": 0.9,
  "to": 2.44,
  "lines": [
   "पंचतंत्र की एक कथा…"
  ]
 },
 {
  "from": 5.4,
  "to": 9.05,
  "lines": [
   "कबूतरों का एक झुंड था।",
   "उनका राजा था, चित्रग्रीव।"
  ]
 },
 {
  "from": 13.1,
  "to": 16.81,
  "lines": [
   "एक दिन एक बहेलिए ने",
   "ज़मीन पर दाने बिखेरे,"
  ]
 },
 {
  "from": 16.85,
  "to": 18.74,
  "lines": [
   "और ऊपर जाल बिछा दिया।"
  ]
 },
 {
  "from": 18.78,
  "to": 21.73,
  "lines": [
   "दाने देखकर,",
   "कबूतर नीचे उतर आए…"
  ]
 },
 {
  "from": 21.77,
  "to": 23.34,
  "lines": [
   "…और सब जाल में फँस गए।"
  ]
 },
 {
  "from": 23.38,
  "to": 26.99,
  "lines": [
   "हर कोई अपनी ओर फड़फड़ाया,",
   "पर जाल हिला तक नहीं।"
  ]
 },
 {
  "from": 27.1,
  "to": 30.62,
  "lines": [
   "तब चित्रग्रीव बोला,",
   "\"घबराओ मत। सब एक साथ उड़ो!\""
  ]
 },
 {
  "from": 30.66,
  "to": 34.09,
  "lines": [
   "और पूरा झुंड, जाल समेत,",
   "आसमान में उड़ गया।"
  ]
 },
 {
  "from": 35.1,
  "to": 38.11,
  "lines": [
   "वे पहुँचे अपने मित्र,",
   "चूहे हिरण्यक के पास।"
  ]
 },
 {
  "from": 38.15,
  "to": 41.45,
  "lines": [
   "चित्रग्रीव बोला, \"पहले",
   "मेरे साथियों को छुड़ाओ,"
  ]
 },
 {
  "from": 41.49,
  "to": 43.22,
  "lines": [
   "मुझे सबसे आख़िर में।\""
  ]
 },
 {
  "from": 43.26,
  "to": 45.92,
  "lines": [
   "हिरण्यक ने",
   "एक-एक धागा काट दिया।"
  ]
 },
 {
  "from": 51.3,
  "to": 53.04,
  "lines": [
   "साथ बैठिए, साथ बाँटिए।"
  ]
 },
 {
  "from": 53.08,
  "to": 56.43,
  "lines": [
   "श्री देसी ठेकुआ —",
   "घर का बना, प्रेम से बना।"
  ]
 },
 {
  "from": 56.47,
  "to": 58.25,
  "lines": [
   "अब आपकी द्वारका तक।"
  ]
 }
]