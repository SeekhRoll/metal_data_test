[
 {
  "from": 0.32,
  "to": 3.04,
  "lines": [
   "राम-राम भइया!",
   "हम हैं रामखेलावन।"
  ]
 },
 {
  "from": 3.08,
  "to": 6.77,
  "lines": [
   "ई देखो हमरा सामान —",
   "एक ठो शेर, एक ठो बकरी,"
  ]
 },
 {
  "from": 6.81,
  "to": 8.34,
  "lines": [
   "और एक ठो गोभी।"
  ]
 },
 {
  "from": 8.52,
  "to": 11.92,
  "lines": [
   "अब ई सबको उस पार वाले",
   "टापू पर पहुँचाना है।"
  ]
 },
 {
  "from": 11.96,
  "to": 14.87,
  "lines": [
   "पर नाव छोटी है —",
   "हमरे अलावा बस एक ठो"
  ]
 },
 {
  "from": 14.91,
  "to": 16.08,
  "lines": [
   "और आ सकत है।"
  ]
 },
 {
  "from": 16.12,
  "to": 17.43,
  "lines": [
   "और मुसीबत ई है —"
  ]
 },
 {
  "from": 17.47,
  "to": 21.04,
  "lines": [
   "शेर को बकरी के साथ अकेला",
   "छोड़ा, तो बकरी गई।"
  ]
 },
 {
  "from": 21.08,
  "to": 24.56,
  "lines": [
   "बकरी को गोभी के साथ छोड़ा,",
   "तो गोभी गई।"
  ]
 },
 {
  "from": 25.12,
  "to": 27.58,
  "lines": [
   "अब बताओ, का करें?",
   "ज़रा सोचो…"
  ]
 },
 {
  "from": 28.42,
  "to": 32.18,
  "lines": [
   "पहले तो हमने सोचा,",
   "सबसे बड़ा सामान पहले ले चलें…"
  ]
 },
 {
  "from": 32.22,
  "to": 34.21,
  "lines": [
   "ई गया हमरा शेर!"
  ]
 },
 {
  "from": 35.02,
  "to": 36.66,
  "lines": [
   "…अरे! गोभिया तो गई!"
  ]
 },
 {
  "from": 36.7,
  "to": 38.75,
  "lines": [
   "ना भइया, ई ना चलेगा।"
  ]
 },
 {
  "from": 39.02,
  "to": 41.31,
  "lines": [
   "पहला चक्कर —",
   "बकरी को ले चलो।"
  ]
 },
 {
  "from": 41.35,
  "to": 44.46,
  "lines": [
   "शेर गोभी नहीं खाता,",
   "तो उधर सब ठीक।"
  ]
 },
 {
  "from": 45.62,
  "to": 47.41,
  "lines": [
   "खाली नाव लेकर वापस।"
  ]
 },
 {
  "from": 53.22,
  "to": 55.21,
  "lines": [
   "ई गया हमरा शेर!"
  ]
 },
 {
  "from": 58.82,
  "to": 60.03,
  "lines": [
   "अब असली चालाकी —"
  ]
 },
 {
  "from": 60.07,
  "to": 63.46,
  "lines": [
   "शेर को उधर छोड़ो, पर",
   "बकरी को वापस ले आओ!"
  ]
 },
 {
  "from": 65.42,
  "to": 68.01,
  "lines": [
   "गोभी ले गए,",
   "शेर के पास रख दिए।"
  ]
 },
 {
  "from": 68.05,
  "to": 70.35,
  "lines": [
   "शेर को का करना गोभी से!"
  ]
 },
 {
  "from": 72.02,
  "to": 73.39,
  "lines": [
   "फिर खाली लौटे।"
  ]
 },
 {
  "from": 78.62,
  "to": 80.63,
  "lines": [
   "और आख़िर में, बकरी।"
  ]
 },
 {
  "from": 85.12,
  "to": 88.11,
  "lines": [
   "सब पहुँच गए, और कोई",
   "किसी को ना खाया!"
  ]
 },
 {
  "from": 88.15,
  "to": 90.04,
  "lines": [
   "सात चक्कर, एक ठो दिमाग।"
  ]
 },
 {
  "from": 90.08,
  "to": 91.45,
  "lines": [
   "का समझे भइया?"
  ]
 }
]