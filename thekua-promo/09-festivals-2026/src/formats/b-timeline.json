 "8": {
  "dur": 22.77,
  "lines": [
   {
    "id": "b8_01",
    "text": "नवरात्रि का आठवाँ दिन, महाअष्टमी — माँ महागौरी।",
    "at": 0.8,
    "dur": 3.5
   },
   {
    "id": "b8_02",
    "text": "चाँदनी जैसी दिव्य आभा, श्वेत वस्त्र, श्वेत वृषभ पर सवार, हाथ में त्रिशूल और डमरू।",
    "at": 4.75,
    "dur": 7.03
   },
   {
    "id": "b8_03",
    "text": "आज कई घरों में कन्या पूजन होता है।",
    "at": 12.23,
    "dur": 2.6
   },
   {
    "id": "b8_04",
    "text": "आज का रंग — बैंगनी।",
    "at": 15.28,
    "dur": 1.5
   },
   {
    "id": "b8_05",
    "text": "भोग — नारियल।",
    "at": 17.23,
    "dur": 0.93
   },
   {
    "id": "b8_06",
    "text": "मंत्र — ॐ देवी महागौर्यै नमः।",
    "at": 18.61,
    "dur": 2.56
   }
  ],
  "scenes": [
