 "7": {
  "dur": 23.63,
  "lines": [
   {
    "id": "b7_01",
    "text": "नवरात्रि का सातवाँ दिन — माँ कालरात्रि।",
    "at": 0.8,
    "dur": 2.95
   },
   {
    "id": "b7_02",
    "text": "देवी का सबसे उग्र रूप — श्याम वर्ण, बिखरे केश, तीन नेत्र, गर्दभ पर सवार।",
    "at": 4.2,
    "dur": 6.19
   },
   {
    "id": "b7_03",
    "text": "पर भक्तों के लिए सदा शुभ — इसीलिए कहलाती हैं शुभंकरी।",
    "at": 10.84,
    "dur": 4.13
   },
   {
    "id": "b7_04",
    "text": "आज का रंग — ग्रे, संतुलन का रंग।",
    "at": 15.42,
    "dur": 2.22
   },
   {
    "id": "b7_05",
    "text": "भोग — गुड़।",
    "at": 18.09,
    "dur": 1.03
   },
   {
    "id": "b7_06",
    "text": "मंत्र — ॐ देवी कालरात्र्यै नमः।",
    "at": 19.57,
    "dur": 2.46
   }
  ],
