 "6": {
  "dur": 21.89,
  "lines": [
   {
    "id": "b6_01",
    "text": "नवरात्रि का छठा दिन — माँ कात्यायनी।",
    "at": 0.8,
    "dur": 2.54
   },
   {
    "id": "b6_02",
    "text": "महिषासुर का वध करने वाली देवी।",
    "at": 3.79,
    "dur": 2.07
   },
   {
    "id": "b6_03",
    "text": "सिंह पर सवार, हाथ में तलवार और कमल।",
    "at": 6.31,
    "dur": 2.92
   },
   {
    "id": "b6_04",
    "text": "व्रज की गोपियों ने भी इन्हीं का व्रत किया था।",
    "at": 9.68,
    "dur": 2.9
   },
   {
    "id": "b6_05",
    "text": "आज का रंग — हरा, नई शुरुआत का रंग।",
    "at": 13.03,
    "dur": 2.64
   },
   {
    "id": "b6_06",
    "text": "भोग — शहद।",
    "at": 16.12,
    "dur": 0.91
   },
   {
    "id": "b6_07",
    "text": "मंत्र — ॐ देवी कात्यायन्यै नमः।",
    "at": 17.48,
    "dur": 2.81
   }
  ],
  "scenes": [
