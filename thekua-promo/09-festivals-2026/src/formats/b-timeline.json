 "4": {
  "dur": 22.12,
  "lines": [
   {
    "id": "b4_01",
    "text": "नवरात्रि का चौथा दिन — माँ कूष्माण्डा।",
    "at": 0.8,
    "dur": 3.26
   },
   {
    "id": "b4_02",
    "text": "अपनी मुस्कान से ब्रह्मांड रचने वाली देवी।",
    "at": 4.51,
    "dur": 2.59
   },
   {
    "id": "b4_03",
    "text": "आठ भुजाएँ, सिंह पर सवार, सूर्य जैसा तेज़।",
    "at": 7.55,
    "dur": 3.45
   },
   {
    "id": "b4_04",
    "text": "आज का रंग — रॉयल ब्लू, दिव्यता और गहराई का रंग।",
    "at": 11.45,
    "dur": 3.82
   },
   {
    "id": "b4_05",
    "text": "भोग — मालपुआ।",
    "at": 15.72,
    "dur": 1.23
   },
   {
    "id": "b4_06",
    "text": "मंत्र — ॐ देवी कूष्माण्डायै नमः।",
    "at": 17.4,
    "dur": 3.12
   }
  ],
