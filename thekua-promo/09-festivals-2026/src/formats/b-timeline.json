 "9": {
  "dur": 22.92,
  "lines": [
   {
    "id": "b9_01",
    "text": "नवरात्रि का नौवाँ दिन, महानवमी — माँ सिद्धिदात्री।",
    "at": 0.8,
    "dur": 3.4
   },
   {
    "id": "b9_02",
    "text": "सभी सिद्धियाँ देने वाली देवी।",
    "at": 4.65,
    "dur": 2.18
   },
   {
    "id": "b9_03",
    "text": "कमल पर विराजमान, चार भुजाएँ — चक्र, गदा, शंख और कमल।",
    "at": 7.28,
    "dur": 4.87
   },
   {
    "id": "b9_04",
    "text": "आज का रंग — मोर-हरा।",
    "at": 12.6,
    "dur": 1.54
   },
   {
    "id": "b9_05",
    "text": "भोग — तिल, और कन्याओं के लिए हलवा-पूरी-चना।",
    "at": 14.59,
    "dur": 3.36
   },
   {
    "id": "b9_06",
    "text": "मंत्र — ॐ देवी सिद्धिदात्र्यै नमः।",
    "at": 18.4,
    "dur": 2.92
   }
  ],
