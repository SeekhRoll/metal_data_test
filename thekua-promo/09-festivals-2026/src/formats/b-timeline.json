 "2": {
  "dur": 21.31,
  "lines": [
   {
    "id": "b2_01",
    "text": "नवरात्रि का दूसरा दिन — माँ ब्रह्मचारिणी।",
    "at": 0.8,
    "dur": 2.72
   },
   {
    "id": "b2_02",
    "text": "तप और संयम की देवी।",
    "at": 3.97,
    "dur": 1.36
   },
   {
    "id": "b2_03",
    "text": "नंगे पाँव, श्वेत वस्त्र, एक हाथ में जप-माला, दूसरे में कमंडल।",
    "at": 5.78,
    "dur": 4.92
   },
   {
    "id": "b2_04",
    "text": "आज का रंग — सफ़ेद, शांति और पवित्रता का रंग।",
    "at": 11.15,
    "dur": 3.34
   },
   {
    "id": "b2_05",
    "text": "भोग — मिश्री।",
    "at": 14.94,
    "dur": 1.11
   },
   {
    "id": "b2_06",
    "text": "मंत्र — ॐ देवी ब्रह्मचारिण्यै नमः।",
    "at": 16.5,
    "dur": 3.21
   }
  ],
