{
 "1": {
  "dur": 21.15,
  "lines": [
   {
    "id": "b1_01",
    "text": "नवरात्रि का पहला दिन — माँ शैलपुत्री।",
    "at": 0.8,
    "dur": 3.01
   },
   {
    "id": "b1_02",
    "text": "पर्वतराज हिमालय की पुत्री।",
    "at": 4.26,
    "dur": 1.61
   },
   {
    "id": "b1_03",
    "text": "नंदी पर सवार, एक हाथ में त्रिशूल, दूसरे में कमल, माथे पर अर्धचंद्र।",
    "at": 6.32,
    "dur": 5.04
   },
   {
    "id": "b1_04",
    "text": "आज का रंग — नारंगी, ऊर्जा और उत्साह का रंग।",
    "at": 11.81,
    "dur": 3.25
   },
   {
    "id": "b1_05",
    "text": "भोग — शुद्ध घी।",
    "at": 15.51,
    "dur": 1.39
   },
   {
    "id": "b1_06",
    "text": "मंत्र — ॐ देवी शैलपुत्र्यै नमः।",
    "at": 17.35,
    "dur": 2.2
   }
  ],
  "scenes": [
