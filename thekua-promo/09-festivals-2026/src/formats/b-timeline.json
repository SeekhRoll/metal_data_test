 "3": {
  "dur": 21.97,
  "lines": [
   {
    "id": "b3_01",
    "text": "नवरात्रि का तीसरा दिन — माँ चंद्रघंटा।",
    "at": 0.8,
    "dur": 2.75
   },
   {
    "id": "b3_02",
    "text": "माथे पर घंटे के आकार का अर्धचंद्र, दस भुजाएँ, अस्त्र-शस्त्र से सजी, बाघ पर सवार।",
    "at": 4.0,
    "dur": 7.47
   },
   {
    "id": "b3_03",
    "text": "आज का रंग — लाल, शक्ति और साहस का रंग।",
    "at": 11.92,
    "dur": 3.27
   },
   {
    "id": "b3_04",
    "text": "भोग — दूध या खीर।",
    "at": 15.64,
    "dur": 1.53
   },
   {
    "id": "b3_05",
    "text": "मंत्र — ॐ देवी चन्द्रघण्टायै नमः।",
    "at": 17.62,
    "dur": 2.75
   }
  ],
