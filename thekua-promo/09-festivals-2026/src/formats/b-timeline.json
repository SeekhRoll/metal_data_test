 "5": {
  "dur": 21.55,
  "lines": [
   {
    "id": "b5_01",
    "text": "नवरात्रि का पाँचवाँ दिन — माँ स्कंदमाता।",
    "at": 0.8,
    "dur": 3.14
   },
   {
    "id": "b5_02",
    "text": "भगवान कार्तिकेय, यानी स्कंद की माता।",
    "at": 4.39,
    "dur": 3.0
   },
   {
    "id": "b5_03",
    "text": "कमल पर विराजमान, गोद में बाल स्कंद, सिंह पर सवार।",
    "at": 7.84,
    "dur": 3.48
   },
   {
    "id": "b5_04",
    "text": "आज का रंग — पीला, आनंद और उजाले का रंग।",
    "at": 11.77,
    "dur": 3.33
   },
   {
    "id": "b5_05",
    "text": "भोग — केला।",
    "at": 15.55,
    "dur": 0.85
   },
   {
    "id": "b5_06",
    "text": "मंत्र — ॐ देवी स्कन्दमातायै नमः।",
    "at": 16.85,
    "dur": 3.1
   }
  ],
  "scenes": [
