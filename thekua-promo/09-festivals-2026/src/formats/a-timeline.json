 },
 "2": {
  "dur": 39.31,
  "estimated": false,
  "lines": [
   {
    "id": "a2_01",
    "text": "नवरात्रि का दूसरा दिन… आज की कथा, साँझी कला शैली में।",
    "at": 0.9,
    "dur": 4.13
   },
   {
    "id": "a2_02",
    "text": "हिमालय की पुत्री पार्वती ने ठान लिया — शिव को पाना है।",
    "at": 5.73,
    "dur": 4.27
   },
   {
    "id": "a2_03",
    "text": "वे वन में गईं, और कठोर तप शुरू किया।",
    "at": 10.7,
    "dur": 2.76
   },
   {
    "id": "a2_04",
    "text": "वर्षों तक फल-फूल खाकर… फिर केवल बेल-पत्र… और फिर पत्ते भी छोड़ दिए। इसीलिए कहलाईं — अपर्णा।",
    "at": 14.16,
    "dur": 7.46
   },
   {
    "id": "a2_05",
    "text": "गर्मी, बारिश, बर्फ़ — कुछ न डिगा सका। अंत में स्वयं ब्रह्मा प्रकट हुए — \"तुम्हारी तपस्या पूरी हुई।\"",
    "at": 22.32,
    "dur": 7.6
   },
   {
    "id": "a2_06",
    "text": "यही हैं माँ ब्रह्मचारिणी।",
    "at": 30.62,
    "dur": 2.43
   },
   {
    "id": "a2_07",
    "text": "संकल्प सच्चा हो, तो कोई लक्ष्य दूर नहीं।",
    "at": 33.75,
    "dur": 3.16
   }
  ],
  "scenes": [
