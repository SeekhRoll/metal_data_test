 },
 "4": {
  "dur": 38.02,
  "estimated": true,
  "lines": [
   {
    "id": "a4_01",
    "text": "नवरात्रि का चौथा दिन… आज की कथा, कोलम कला शैली में।",
    "at": 0.9,
    "dur": 4.33
   },
   {
    "id": "a4_02",
    "text": "जब कुछ भी नहीं था — न सूरज, न तारे… बस घना अंधकार।",
    "at": 5.94,
    "dur": 4.25
   },
   {
    "id": "a4_03",
    "text": "तब एक देवी… मुस्कुराईं।",
    "at": 10.89,
    "dur": 1.96
   },
   {
    "id": "a4_04",
    "text": "उस मंद मुस्कान से, एक ब्रह्मांडीय अंड प्रकट हुआ…",
    "at": 13.54,
    "dur": 4.08
   },
   {
    "id": "a4_05",
    "text": "…और उससे जन्मा पूरा ब्रह्मांड। सूरज जला, तारे जगमगाए, धरती पर जीवन खिल उठा।",
    "at": 18.32,
    "dur": 6.38
   },
   {
    "id": "a4_06",
    "text": "वे सूर्य के भीतर निवास करती हैं। यही हैं माँ कूष्माण्डा।",
    "at": 25.4,
    "dur": 4.76
   },
   {
    "id": "a4_07",
    "text": "एक सच्ची मुस्कान में, पूरी दुनिया रचने की ताक़त होती है।",
    "at": 30.86,
    "dur": 4.76
   }
  ],
