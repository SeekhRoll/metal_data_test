 },
 "3": {
  "dur": 44.2,
  "estimated": false,
  "lines": [
   {
    "id": "a3_01",
    "text": "नवरात्रि का तीसरा दिन… आज की कथा, मधुबनी चित्रकला शैली में।",
    "at": 0.9,
    "dur": 4.6
   },
   {
    "id": "a3_02",
    "text": "शिव और पार्वती का विवाह तय हुआ। पूरा महल सजा था।",
    "at": 6.2,
    "dur": 4.16
   },
   {
    "id": "a3_03",
    "text": "पर जब बारात आई — भूत, प्रेत, गण, और भस्म रमाए शिव… माँ मैना देखकर मूर्छित हो गईं।",
    "at": 11.06,
    "dur": 7.32
   },
   {
    "id": "a3_04",
    "text": "तब पार्वती ने धारण किया एक तेजस्वी रूप — माथे पर घंटे जैसा अर्धचंद्र, दस भुजाएँ।",
    "at": 19.08,
    "dur": 6.58
   },
   {
    "id": "a3_05",
    "text": "वे शिव के सामने गईं, और विनती की — मेरे परिवार के लिए, सुंदर रूप में आइए।",
    "at": 26.36,
    "dur": 5.45
   },
   {
    "id": "a3_06",
    "text": "शिव मुस्कुराए, और आए चंद्रशेखर बनकर — राजकुमार जैसे दूल्हे।",
    "at": 32.51,
    "dur": 5.34
   },
   {
    "id": "a3_07",
    "text": "साहस और कोमलता — दोनों साथ चल सकते हैं।",
    "at": 38.55,
    "dur": 3.25
   }
  ],
  "scenes": [
