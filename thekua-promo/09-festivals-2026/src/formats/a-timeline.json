 "9": {
  "dur": 43.05,
  "estimated": true,
  "lines": [
   {
    "id": "a9_01",
    "text": "नवरात्रि का नौवाँ दिन… आज, अंतिम कथा — तंजावुर चित्रकला शैली में।",
    "at": 0.9,
    "dur": 5.53
   },
   {
    "id": "a9_02",
    "text": "सृष्टि के आरंभ में, शिव ने आदिशक्ति की आराधना की।",
    "at": 7.13,
    "dur": 4.17
   },
   {
    "id": "a9_03",
    "text": "देवी प्रसन्न हुईं, और उन्हें सिद्धियाँ प्रदान कीं।",
    "at": 11.99,
    "dur": 4.25
   },
   {
    "id": "a9_04",
    "text": "तब शिव का आधा शरीर देवी का हो गया — और वे कहलाए अर्धनारीश्वर। आधा शिव… आधी शक्ति।",
    "at": 16.94,
    "dur": 6.89
   },
   {
    "id": "a9_05",
    "text": "देवता, ऋषि, मनुष्य — सब इन्हीं से सिद्धि पाते हैं।",
    "at": 24.53,
    "dur": 4.25
   },
   {
    "id": "a9_06",
    "text": "यही हैं माँ सिद्धिदात्री।",
    "at": 29.48,
    "dur": 2.12
   },
   {
    "id": "a9_07",
    "text": "शिव और शक्ति — एक के बिना, दूसरा अधूरा।",
    "at": 32.3,
    "dur": 3.32
   },
   {
    "id": "a9_08",
    "text": "नौ दिन, नौ देवियाँ, भारत की नौ कलाएँ… शुभ नवरात्रि।",
    "at": 36.32,
    "dur": 4.33
   }
  ],
