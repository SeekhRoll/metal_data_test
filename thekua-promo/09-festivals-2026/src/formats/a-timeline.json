 "6": {
  "dur": 39.21,
  "estimated": true,
  "lines": [
   {
    "id": "a6_01",
    "text": "नवरात्रि का छठा दिन… सुनो, सुनो, आज की कथा, बंगाल पटचित्र शैली में।",
    "at": 0.9,
    "dur": 5.7
   },
   {
    "id": "a6_02",
    "text": "महिषासुर का आतंक बढ़ता जा रहा था।",
    "at": 7.3,
    "dur": 2.81
   },
   {
    "id": "a6_03",
    "text": "महर्षि कात्यायन ने वर्षों तप किया — कि देवी उनकी बेटी बनकर आएँ।",
    "at": 10.8,
    "dur": 5.36
   },
   {
    "id": "a6_04",
    "text": "देवताओं का तेज़ मिला… और ऋषि के आश्रम में प्रकट हुईं — कात्यायनी।",
    "at": 16.86,
    "dur": 5.53
   },
   {
    "id": "a6_05",
    "text": "महिषासुर ने रूप बदले — भैंसा, सिंह, हाथी… पर माँ के आगे कोई छल न चला।",
    "at": 23.08,
    "dur": 5.87
   },
   {
    "id": "a6_06",
    "text": "अधर्म का अंत हुआ। यही हैं माँ कात्यायनी।",
    "at": 29.65,
    "dur": 3.4
   },
   {
    "id": "a6_07",
    "text": "अन्याय के सामने, चुप रहना धर्म नहीं।",
    "at": 33.75,
    "dur": 3.06
   }
  ],
