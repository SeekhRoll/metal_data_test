 "8": {
  "dur": 36.23,
  "estimated": true,
  "lines": [
   {
    "id": "a8_01",
    "text": "नवरात्रि का आठवाँ दिन… आज की कथा, मैसूर चित्रकला शैली में।",
    "at": 0.9,
    "dur": 4.93
   },
   {
    "id": "a8_02",
    "text": "शिव को पाने के लिए, पार्वती ने वर्षों कठोर तप किया — धूप, वर्षा, आँधी… सब सहती रहीं।",
    "at": 6.53,
    "dur": 7.14
   },
   {
    "id": "a8_03",
    "text": "न भूख डिगा सकी, न थकान।",
    "at": 14.37,
    "dur": 1.96
   },
   {
    "id": "a8_04",
    "text": "जब तप पूरा हुआ, शिव प्रसन्न हुए, और गंगा के पवित्र जल से उनका अभिषेक किया।",
    "at": 17.03,
    "dur": 6.29
   },
   {
    "id": "a8_05",
    "text": "उस क्षण, उनका तेज़ चाँदनी की तरह दमक उठा।",
    "at": 24.02,
    "dur": 3.49
   },
   {
    "id": "a8_06",
    "text": "यही हैं माँ महागौरी।",
    "at": 28.2,
    "dur": 1.7
   },
   {
    "id": "a8_07",
    "text": "सच्ची साधना का तेज़… भीतर से चमकता है।",
    "at": 30.6,
    "dur": 3.23
   }
  ],
  "scenes": [
