 "5": {
  "dur": 39.77,
  "estimated": false,
  "lines": [
   {
    "id": "a5_01",
    "text": "नवरात्रि का पाँचवाँ दिन… आज की कथा, केरल भित्तिचित्र शैली में।",
    "at": 0.9,
    "dur": 4.83
   },
   {
    "id": "a5_02",
    "text": "तारकासुर को वरदान था — उसे केवल शिव का पुत्र ही हरा सकता है। देवता संकट में थे।",
    "at": 6.43,
    "dur": 6.42
   },
   {
    "id": "a5_03",
    "text": "तब जन्म हुआ शिव और पार्वती के पुत्र का — स्कंद, जिन्हें कार्तिकेय भी कहते हैं।",
    "at": 13.56,
    "dur": 6.5
   },
   {
    "id": "a5_04",
    "text": "माँ ने उन्हें प्रेम से पाला… सिखाया… सँवारा।",
    "at": 20.76,
    "dur": 3.46
   },
   {
    "id": "a5_05",
    "text": "बड़े होकर स्कंद देवताओं के सेनापति बने, और तारकासुर का अंत किया।",
    "at": 24.91,
    "dur": 5.9
   },
   {
    "id": "a5_06",
    "text": "यही हैं माँ स्कंदमाता।",
    "at": 31.51,
    "dur": 2.12
   },
   {
    "id": "a5_07",
    "text": "हर वीर के पीछे, एक माँ की ममता होती है।",
    "at": 34.33,
    "dur": 3.04
   }
  ],
