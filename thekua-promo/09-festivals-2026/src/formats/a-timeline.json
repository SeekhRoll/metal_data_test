 "7": {
  "dur": 46.43,
  "estimated": true,
  "lines": [
   {
    "id": "a7_01",
    "text": "नवरात्रि का सातवाँ दिन… आज की कथा, दीये की लौ और छाया में — तोलु बोम्मलाटा कठपुतली शैली में।",
    "at": 0.9,
    "dur": 7.82
   },
   {
    "id": "a7_02",
    "text": "रक्तबीज नाम का असुर — उसकी हर बूँद, ज़मीन पर गिरते ही, एक नया रक्तबीज बन जाती।",
    "at": 9.42,
    "dur": 6.63
   },
   {
    "id": "a7_03",
    "text": "जितना लड़ो… उतने बढ़ते जाते।",
    "at": 16.75,
    "dur": 2.38
   },
   {
    "id": "a7_04",
    "text": "तब देवी ने धारण किया सबसे उग्र रूप — अंधकार जैसा श्याम वर्ण, तीन नेत्र, साँसों में अग्नि।",
    "at": 19.83,
    "dur": 7.57
   },
   {
    "id": "a7_05",
    "text": "उन्होंने एक भी बूँद धरती तक पहुँचने न दी… और रक्तबीज का अंत हुआ।",
    "at": 28.09,
    "dur": 5.44
   },
   {
    "id": "a7_06",
    "text": "रूप भले भयानक हो, पर भक्तों के लिए वे सदा शुभ करती हैं। यही हैं माँ कालरात्रि।",
    "at": 34.23,
    "dur": 6.63
   },
   {
    "id": "a7_07",
    "text": "रूप से नहीं… कर्म से पहचानिए।",
    "at": 41.56,
    "dur": 2.47
   }
  ],
