[
 {
  "from": 0.9,
  "to": 3.67,
  "lines": [
   "रामायण की",
   "एक छोटी-सी कथा…"
  ]
 },
 {
  "from": 5.5,
  "to": 9.63,
  "lines": [
   "लंका जाने के लिए,",
   "समुद्र पर पुल बनाना था।"
  ]
 },
 {
  "from": 13.3,
  "to": 16.2,
  "lines": [
   "वानर सेना",
   "बड़े-बड़े पत्थर उठाती,"
  ]
 },
 {
  "from": 16.24,
  "to": 20.07,
  "lines": [
   "उन पर \"राम\" लिखती…",
   "और पत्थर तैरने लगते।"
  ]
 },
 {
  "from": 21.2,
  "to": 24.32,
  "lines": [
   "पर किनारे पर",
   "एक नन्ही गिलहरी भी थी।"
  ]
 },
 {
  "from": 24.36,
  "to": 27.03,
  "lines": [
   "पानी में भीगती,",
   "रेत में लोटती,"
  ]
 },
 {
  "from": 27.07,
  "to": 29.46,
  "lines": [
   "और पुल की दरारों में",
   "रेत झाड़ आती। बार-बार।"
  ]
 },
 {
  "from": 29.5,
  "to": 33.38,
  "lines": [
   "एक वानर हँसा,",
   "\"तेरी रेत से क्या होगा?\""
  ]
 },
 {
  "from": 36.3,
  "to": 40.01,
  "lines": [
   "श्रीराम ने उसे उठाया,",
   "प्यार से पीठ सहलाई।"
  ]
 },
 {
  "from": 40.05,
  "to": 40.86,
  "lines": [
   "\"इसका योगदान भी",
   "उतना ही बड़ा है।\""
  ]
 },
 {
  "from": 40.9,
  "to": 43.99,
  "lines": [
   "कहते हैं, तभी से",
   "गिलहरी की पीठ पर"
  ]
 },
 {
  "from": 44.03,
  "to": 45.8,
  "lines": [
   "तीन धारियाँ हैं।"
  ]
 },
 {
  "from": 52.5,
  "to": 55.67,
  "lines": [
   "श्री देसी ठेकुआ भी",
   "ऐसे ही बनता है —"
  ]
 },
 {
  "from": 55.71,
  "to": 58.51,
  "lines": [
   "एक-एक करके, हाथ से,",
   "पूरे मन से।"
  ]
 },
 {
  "from": 58.55,
  "to": 60.55,
  "lines": [
   "अब आपकी द्वारका तक।"
  ]
 }
]