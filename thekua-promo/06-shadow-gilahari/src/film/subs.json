[
 {
  "from": 0.9,
  "to": 3.04,
  "lines": [
   "रामायण की",
   "एक छोटी-सी कथा…"
  ]
 },
 {
  "from": 5.5,
  "to": 9.25,
  "lines": [
   "लंका जाने के लिए,",
   "समुद्र पर पुल बनाना था।"
  ]
 },
 {
  "from": 13.3,
  "to": 15.77,
  "lines": [
   "वानर सेना",
   "बड़े-बड़े पत्थर उठाती,"
  ]
 },
 {
  "from": 15.81,
  "to": 19.13,
  "lines": [
   "उन पर \"राम\" लिखती…",
   "और पत्थर तैरने लगते।"
  ]
 },
 {
  "from": 21.1,
  "to": 23.88,
  "lines": [
   "पर किनारे पर",
   "एक नन्ही गिलहरी भी थी।"
  ]
 },
 {
  "from": 23.92,
  "to": 26.31,
  "lines": [
   "पानी में भीगती,",
   "रेत में लोटती,"
  ]
 },
 {
  "from": 26.35,
  "to": 30.07,
  "lines": [
   "और पुल की दरारों में",
   "रेत झाड़ आती। बार-बार।"
  ]
 },
 {
  "from": 30.4,
  "to": 33.57,
  "lines": [
   "एक वानर हँसा,",
   "\"तेरी रेत से क्या होगा?\""
  ]
 },
 {
  "from": 36.1,
  "to": 39.02,
  "lines": [
   "श्रीराम ने उसे उठाया,",
   "प्यार से पीठ सहलाई।"
  ]
 },
 {
  "from": 39.06,
  "to": 41.69,
  "lines": [
   "\"इसका योगदान भी",
   "उतना ही बड़ा है।\""
  ]
 },
 {
  "from": 42.2,
  "to": 44.81,
  "lines": [
   "कहते हैं, तभी से",
   "गिलहरी की पीठ पर"
  ]
 },
 {
  "from": 44.85,
  "to": 46.38,
  "lines": [
   "तीन धारियाँ हैं।"
  ]
 },
 {
  "from": 52.1,
  "to": 55.08,
  "lines": [
   "श्री देसी ठेकुआ भी",
   "ऐसे ही बनता है —"
  ]
 },
 {
  "from": 55.12,
  "to": 57.75,
  "lines": [
   "एक-एक करके, हाथ से,",
   "पूरे मन से।"
  ]
 },
 {
  "from": 57.79,
  "to": 59.68,
  "lines": [
   "अब आपकी द्वारका तक।"
  ]
 }
]